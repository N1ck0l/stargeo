# ============================================================================
# Variáveis de ambiente
#
# COPIE PARA `.env` E PREENCHA. O `.env` NUNCA vai para o git.
#
# Onde cada uma é usada:
#   - `create-checkout`, `mp-webhook`, `track-order`, `resend-certificate`
#     rodam na Edge Function e lêem do ambiente DO SERVIDOR (Deno), não deste
#     arquivo. As instructions de deploy estão no README da loja.
#   - `VITE_*` vai para o navegador, e é lido pelo app da loja.
# ============================================================================

# ----------------------------------------------------------------------------
# Mercado Pago
# ----------------------------------------------------------------------------
# Painel: https://www.mercadopago.com.br/developers/panel/app
#
# "Credenciais de produção" mostra o ACCESS TOKEN. O token de teste é outro, e
# o sandbox_init_point só funciona com ele. Comece no de teste.
MERCADO_PAGO_ACCESS_TOKEN=

# O segredo do webhook fica em "Webhooks" no painel, no mesmo painel onde se
# cadastrou a URL. É o que assina o corpo da requisição.
#
# Sem isso a função recusa TODO webhook com 401 e ninguém recebe certificado.
MERCADO_PAGO_WEBHOOK_SECRET=

# O que aparece na fatura do cartão do cliente. Limite curto, e sem acento
# inventado — o adquirente rejeita descritores longos ou com caracteres fora
# do esperado.
MP_STATEMENT_DESCRIPTOR=STARGEO

# ----------------------------------------------------------------------------
# E-mail (Resend)
# ----------------------------------------------------------------------------
# https://resend.com — o domínio precisa ter o DNS configurado (SPF + DKIM)
# antes de mandar para endereços reais.
RESEND_API_KEY=

# Precisa ser de um domínio seu e verificado. O formato com chaves é o padrão
# do Resend e evita que o e-mail caia em spam:
# "StarGeo <certificado@seudominio.com.br>"
EMAIL_FROM="StarGeo <certificado@seudominio.com.br>"

# ----------------------------------------------------------------------------
# URLs do projeto
# ----------------------------------------------------------------------------
# Onde a loja está publicada. Usado nos links do e-mail e no retorno do
# Mercado Pago.
PUBLIC_SITE_URL=http://localhost:5173

# De onde a Edge Function baixa as fontes woff2 para embutir no PDF.
#
# A função não tem a pasta `public/` do projeto, então as fontes vêm do site
# já publicado. Apontar para o próprio site funciona; um CDN dá o mesmo
# resultado com menos latência.
FONTS_BASE_URL=http://localhost:5173

# Quais domínios podem chamar as Edge Functions (CORS). Lista separada por
# vírgula, sem barra no fim. `localhost` já é liberado por padrão.
#
# Sem isto em produção, o navegador bloqueia TODAS as chamadas da loja com
# erro de CORS — e o sintoma é "não foi possível iniciar o pagamento", que não
# aponta para a causa.
ORIGENS_PERMITIDAS=https://loja.seudominio.com.br

# ----------------------------------------------------------------------------
# Só o navegador (prefixo VITE_ é obrigatório: sem ele a Vite não expõe)
# ----------------------------------------------------------------------------
# URL e chave ANON do projeto Supabase.
#
# A chave anônima é pública por definição — ela vai no bundle. O que protege
# os dados é o RLS: `orders` não tem nenhuma política para `anon`, então nem
# com a chave em mãos dá para ler um pedido pelo Data API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL pública de cada Edge Function.
VITE_FUNCTIONS_URL=
VITE_MERCADO_PAGO_PUBLIC_KEY=
