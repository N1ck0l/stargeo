{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-undef": "error"
  },
  "ignorePatterns": [
    "dist-loja/**",
    "node_modules/**",
    "loja/public/**",
    ".netlify/**"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "overrides": [
    {
      "files": [
        "supabase/functions/**",
        "netlify/**"
      ],
      "globals": {
        "Deno": "readonly",
        "Netlify": "readonly"
      }
    },
    {
      "files": [
        "scripts/**",
        "**/*.test.mjs",
        "shared/**/*.test.mjs"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "test/**",
        "vitest.config.js",
        "loja/vite.config.js"
      ],
      "env": {
        "node": true
      },
      "globals": {
        "globalThis": "readonly"
      }
    }
  ]
}
