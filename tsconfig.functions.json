{
  "//": "Configuração de tipo das Edge Functions. O runtime é o Deno, então os tipos do Deno e do Supabase vêm de CDN. É o alvo de `npm run typecheck`.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Edge Functions importam o próprio arquivo com extensão (`./index.ts`),
    // o que só é permitido com isto ligado.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    // `shared/` é lido por este tsconfig, e ele não pode ganhar código morto
    // às custas das functions: uma variável esquecida lá vira erro aqui.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    // Só checagem: a compilação em si é do empacotador do Deno em deploy.
    "noEmit": true,
    "allowJs": true,
    /*
     * `types: []` desliga a descoberta automática de `@types/*`. Sem isso o
     * compilador arrasta os tipos de `chai` (do Vitest), que dependem de
     * `moduleResolution` estilo Node — e polui o resultado com dezenas de
     * erros que não têm nada a ver com as Edge Functions.
     */
    "types": [],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    /*
     * O runtime é o Deno, onde o import é `npm:@supabase/supabase-js@2`. O
     * compilador do editor não entende o prefixo `npm:`, então o caminho é
     * mapeado para o pacote real do node_modules — só para conferir tipos.
     * Em tempo de execução o `npm:` é o que vale.
     */
    "paths": {
      "npm:@supabase/supabase-js@2": ["./node_modules/@supabase/supabase-js/dist/index.d.cts"]
    }
  },
  // `shared/` entra porque as functions importam os módulos de lá (e são JS
  // puro, checáveis com allowJs). A loja (`loja/`) e os testes (`test/`) ficam
  // de fora: eles têm seu próprio caminho de build via Vite.
  "include": ["supabase/functions/**/*.ts", "supabase/functions/**/*.d.ts", "shared/**/*.js"],
  "exclude": ["node_modules", "dist-loja", "test"]
}
